{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "rede": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:all",
    "test:all": "npm run test:regression && npm run test:integration && npm run test:e2e",
    "test:regression": "vitest run --config test-suites/regression.config.js",
    "test:integration": "npm run test:integration:configurador && npm run test:integration:chamados && npm run test:integration:projetos",
    "test:integration:configurador": "vitest run --config test-suites/configurador.config.js",
    "test:integration:chamados": "vitest run --config test-suites/chamados.config.js",
    "test:integration:projetos": "vitest run --config test-suites/projetos.config.js",
    "test:e2e": "vitest run --config test-suites/e2e.config.js",
    "test:e2e:browser": "cypress run --e2e --browser electron",
    "test:e2e:browser:open": "cypress open --e2e",
    "test:fast": "npm run test:regression",
    "test:coverage": "vitest run --coverage --config test-suites/coverage.config.js",
    "test:quality": "npm run lint && npm run test:all && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "axios": "^1.19.0",
    "github-slugger": "^2.0.0",
    "graphql": "^16.13.2",
    "lucide-react": "^1.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cypress": "^16.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
